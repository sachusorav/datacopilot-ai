# DataCopilot AI Configuration Template

# Security & JWT Authentication
SECRET_KEY=generate_a_random_32_character_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# LLM Providers Configuration
# Order options: ollama,groq,fallback or groq,ollama,fallback
LLM_PROVIDER_ORDER=ollama,groq,fallback

# Local Ollama Provider Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Hosted Groq Provider Settings (Free Tier)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
